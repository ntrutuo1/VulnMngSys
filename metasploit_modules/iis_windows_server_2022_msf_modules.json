{
  "profile_name": "iis_http_sys_windows_server_2022_plus_metasploit_scan",
  "schema_version": "2026-06-08",
  "scope": {
    "authorization": "local/authorized scanning only",
    "target_os": "Windows Server 2022 and newer",
    "target_service": "Microsoft IIS / HTTP.sys",
    "module_policy": "Only IIS/HTTP.sys service checks relevant to Windows Server 2022+ are included. Legacy CVE probes and non-service content discovery modules are removed.",
    "default_targets": ["127.0.0.1", "localhost"],
    "default_ports": [80, 443],
    "execution_mode": "msfrpc + pymetasploit3",
    "safe_default": true,
    "notes": [
      "This profile uses auxiliary scanner modules only.",
      "DoS, memory dump, exploit payload, and pre-2022 legacy CVE modules are not loaded.",
      "Module option names can differ between Metasploit releases; verify with module.info/options on the installed framework."
    ]
  },
  "common_http_options": {
    "RHOSTS": "127.0.0.1",
    "RPORT": 80,
    "SSL": false,
    "VHOST": "",
    "THREADS": 1,
    "HttpClientTimeout": 20,
    "Proxies": "",
    "UserAgent": "Mozilla/5.0 VulnMngSys IIS authorized scanner"
  },
  "common_https_options": {
    "RHOSTS": "127.0.0.1",
    "RPORT": 443,
    "SSL": true,
    "VHOST": "",
    "THREADS": 1,
    "HttpClientTimeout": 20,
    "Proxies": "",
    "UserAgent": "Mozilla/5.0 VulnMngSys IIS authorized scanner"
  },
  "modules": [
    {
      "id": "iis_http_version",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/http_version",
      "name": "IIS / HTTP.sys service fingerprint",
      "category": "iis_service_fingerprinting",
      "risk": "banner_version_exposure",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Collects HTTP service fingerprinting for IIS/HTTP.sys on Windows Server 2022 and newer.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false},
        {"RPORT": 443, "SSL": true}
      ],
      "expected_signal": "Reports HTTP server/banner fingerprint for IIS or HTTP.sys."
    },
    {
      "id": "iis_http_options",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/options",
      "name": "IIS allowed HTTP methods",
      "category": "iis_service_method_hardening",
      "risk": "dangerous_methods_enabled",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Checks exposed IIS HTTP methods on Windows Server 2022+ sites.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "TARGETURI": "/",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false, "TARGETURI": "/"},
        {"RPORT": 443, "SSL": true, "TARGETURI": "/"}
      ],
      "expected_signal": "Reports Allow header and risky methods such as TRACE, PUT, DELETE, or WebDAV verbs."
    },
    {
      "id": "iis_trace_method",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/trace",
      "name": "IIS TRACE method exposure",
      "category": "iis_service_method_hardening",
      "risk": "dangerous_methods_enabled",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Validates whether TRACE is enabled on IIS/HTTP.sys despite modern hardening expectations.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false},
        {"RPORT": 443, "SSL": true}
      ],
      "expected_signal": "Reports vulnerable when TRACE reflects request content."
    },
    {
      "id": "iis_webdav_scanner",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/webdav_scanner",
      "name": "IIS WebDAV service exposure",
      "category": "iis_service_feature_hardening",
      "risk": "webdav_enabled",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Detects WebDAV exposure on IIS where it is not required.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "PATH": "/",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false, "PATH": "/"},
        {"RPORT": 443, "SSL": true, "PATH": "/"}
      ],
      "expected_signal": "Reports WebDAV/SharePoint DAV support."
    },
    {
      "id": "iis_http_put_write_test",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/http_put",
      "name": "IIS PUT write capability test",
      "category": "iis_service_active_write_test",
      "risk": "unauthorized_write_delete",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Actively verifies writable IIS paths. Only run against authorized lab/local targets.",
      "safe_to_run": "conditional",
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "PATH": "/",
        "FILENAME": "vulnmngsys_iis_put_test.txt",
        "FILEDATA": "vulnmngsys authorized test file",
        "ACTION": "PUT",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false, "PATH": "/", "ACTION": "PUT"},
        {"RPORT": 443, "SSL": true, "PATH": "/", "ACTION": "PUT"}
      ],
      "expected_signal": "Reports successful upload/write when IIS path accepts PUT."
    },
    {
      "id": "iis_shortname_scanner",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/iis_shortname_scanner",
      "name": "IIS 8.3 short-name enumeration",
      "category": "iis_service_information_disclosure",
      "risk": "information_disclosure",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Checks whether modern IIS still exposes 8.3 short-name enumeration.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "PATH": "/",
        "THREADS": 20
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false, "PATH": "/"},
        {"RPORT": 443, "SSL": true, "PATH": "/"}
      ],
      "expected_signal": "Reports discovered 8.3-style short names."
    },
    {
      "id": "iis_directory_listing",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/dir_listing",
      "name": "IIS directory browsing exposure",
      "category": "iis_service_content_exposure",
      "risk": "directory_listing",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Checks whether IIS Directory Browsing is enabled on the target path.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 80,
        "SSL": false,
        "VHOST": "",
        "PATH": "/",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 80, "SSL": false, "PATH": "/"},
        {"RPORT": 443, "SSL": true, "PATH": "/"}
      ],
      "expected_signal": "Reports index/directory listing output."
    },
    {
      "id": "iis_tls_versions",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/ssl/ssl_version",
      "name": "IIS HTTPS TLS protocol check",
      "category": "iis_service_tls_hardening",
      "risk": "weak_tls_protocols_or_ciphers",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Checks IIS HTTPS bindings for weak TLS protocol exposure on Windows Server 2022+.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 443,
        "SSLVersion": "All",
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 443}
      ],
      "expected_signal": "Reports supported SSL/TLS protocol versions and weak protocol exposure."
    },
    {
      "id": "iis_https_certificate",
      "module_type": "auxiliary",
      "module": "auxiliary/scanner/http/cert",
      "name": "IIS HTTPS certificate check",
      "category": "iis_service_tls_certificate",
      "risk": "expired_or_untrusted_certificate",
      "cve": [],
      "year_scope": "2022+",
      "server_2022_relevance": "Checks IIS HTTPS certificate expiry and issuer properties.",
      "safe_to_run": true,
      "default_datastore": {
        "RHOSTS": "127.0.0.1",
        "RPORT": 443,
        "ISSUER": ".*",
        "SHOWALL": false,
        "THREADS": 1
      },
      "local_variants": [
        {"RPORT": 443}
      ],
      "expected_signal": "Reports expired certificate or issuer mismatch."
    }
  ],
  "excluded_or_dangerous_modules": [],
  "pymetasploit3_runner_template": {
    "description": "Load each module via msfrpc and override default_datastore per target/port.",
    "pseudo_code": [
      "from pymetasploit3.msfrpc import MsfRpcClient",
      "client = MsfRpcClient('<password>', server='127.0.0.1', port=55552, ssl=False)",
      "mod = client.modules.use('auxiliary', '<module path without auxiliary/>')",
      "for k, v in default_datastore.items(): mod[k] = v",
      "job = mod.execute()"
    ]
  }
}
