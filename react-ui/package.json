{
  "name": "vulnmngsys-react-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:electron": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "antd": "^5.21.6",
    "i18next": "^26.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.vulnmngsys.desktop",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
