  {
    "id": "5.1",
    "title": "Print Spooler (Spooler)",
    "description": "Vô hiệu hóa dịch vụ Print Spooler để giảm bề mặt tấn công",
    "recommended": "Disabled",
    "registry": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Spooler",
    "registry_keys": {
      "Start": { "type": "REG_DWORD", "value": 4 }
    },
    "powershell_equivalent": "Set-Service -Name Spooler -StartupType Disabled"
  },
